{
  "name": "markdown-translator",
  "displayName": "Markdown Translator",
  "description": "VSCode插件 - 智能markdown文档翻译工具，支持多种翻译引擎和LLM API",
  "version": "0.0.1",
  "publisher": "markdown-translator",
  "repository": "https://github.com/your-username/markdown-translator",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "translator",
    "translate",
    "中文",
    "english",
    "llm",
    "ai"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markdownTranslator.translateToEnglish",
        "title": "翻译为英文",
        "category": "Markdown Translator"
      },
      {
        "command": "markdownTranslator.translateToChinese",
        "title": "翻译为中文",
        "category": "Markdown Translator"
      },
      {
        "command": "markdownTranslator.translateSelection",
        "title": "翻译选中文本",
        "category": "Markdown Translator"
      },
      {
        "command": "markdownTranslator.autoTranslate",
        "title": "自动翻译当前文档",
        "category": "Markdown Translator"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceExtname == .md",
          "command": "markdownTranslator.translateSelection",
          "group": "1_modification"
        }
      ],
      "editor/title": [
        {
          "when": "resourceExtname == .md",
          "command": "markdownTranslator.autoTranslate",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Markdown Translator",
      "properties": {
        "markdownTranslator.defaultEngine": {
          "type": "string",
          "default": "google",
          "enum": [
            "google",
            "baidu",
            "openai",
            "claude"
          ],
          "description": "默认翻译引擎"
        },
        "markdownTranslator.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API密钥"
        },
        "markdownTranslator.claudeApiKey": {
          "type": "string",
          "default": "",
          "description": "Claude API密钥"
        },
        "markdownTranslator.baiduAppId": {
          "type": "string",
          "default": "",
          "description": "百度翻译APP ID"
        },
        "markdownTranslator.baiduSecretKey": {
          "type": "string",
          "default": "",
          "description": "百度翻译密钥"
        },
        "markdownTranslator.autoFilter": {
          "type": "boolean",
          "default": true,
          "description": "自动过滤代码块和内联代码"
        },
        "markdownTranslator.autoTranslateOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "打开md文件时自动翻译"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.27.0",
    "@typescript-eslint/parser": "^5.27.0",
    "@vscode/test-electron": "^2.1.5",
    "@vscode/vsce": "^2.19.0",
    "eslint": "^8.16.0",
    "typescript": "^4.7.4"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "crypto-js": "^4.1.1"
  }
}
